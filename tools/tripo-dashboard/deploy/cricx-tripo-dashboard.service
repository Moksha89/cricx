[Unit]
Description=Cricx Tripo asset workshop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cricx
Group=cricx
WorkingDirectory=/opt/cricx/tripo-dashboard
EnvironmentFile=/etc/cricx/tripo.env
ExecStart=/usr/bin/python3 /opt/cricx/tripo-dashboard/server.py --port 8876
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077

[Install]
WantedBy=multi-user.target
